GET /book3-r01-pilot01/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-08-03T00:00:00+09:00",
              "lt": "2026-11-01T00:00:00+09:00"
            }
          }
        },
        {
          "term": {
            "decoder.name": "web-accesslog"
          }
        }
      ]
    }
  },
  "aggs": {
    "by_vhost": {
      "terms": {
        "field": "data.vhost",
        "size": 10
      },
      "aggs": {
        "visitors": {
          "cardinality": {
            "field": "data.srcip",
            "precision_threshold": 40000
          }
        },
        "bytes": {
          "sum": {
            "field": "data.bytes"
          }
        },
        "avg_bytes": {
          "avg": {
            "field": "data.bytes"
          }
        }
      }
    }
  }
}
