GET /book3-r12-ch11/_search
{
  "size": 20,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-08-03T00:00:00+09:00",
              "lt": "2026-11-01T00:00:00+09:00"
            }
          }
        },
        {
          "terms": {
            "data.ai.tool": [
              "http_fetch",
              "file_read",
              "shell"
            ]
          }
        }
      ]
    }
  },
  "aggs": {
    "users": {
      "terms": {
        "field": "data.ai.user",
        "size": 10
      }
    }
  },
  "sort": [
    {
      "timestamp": "asc"
    }
  ],
  "_source": [
    "timestamp",
    "agent.name",
    "data"
  ]
}
