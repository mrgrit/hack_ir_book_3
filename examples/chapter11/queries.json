                    {
                      "term": {
                        "data.ai.blocked": "false"
                      }
                    }
                  ]
                }
              },
              "unflagged": {
                "bool": {
                  "must_not": [
                    {
                      "term": {
                        "data.ai.flags": "injection_pattern"
                      }
                    }
