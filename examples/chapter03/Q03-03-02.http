GET /book3-r02-ch03/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-08-03T00:00:00+09:00",
              "lt": "2026-11-01T00:00:00+09:00"
            }
          }
        },
        {
          "term": {
            "decoder.name": "web-accesslog"
          }
        }
      ]
    }
  },
  "aggs": {
    "by_ip": {
      "terms": {
        "field": "data.srcip",
        "size": 5
      },
      "aggs": {
        "ua": {
          "terms": {
            "field": "data.user_agent",
            "size": 1
          }
        }
      }
    }
  }
}
