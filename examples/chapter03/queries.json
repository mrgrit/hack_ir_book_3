  "01": {
    "title": "전체 자료와 로그 출처",
    "method": "GET",
    "path": "/book3-r02-ch03/_search",
    "body": {
      "size": 0,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2026-08-03T00:00:00+09:00",
                  "lt": "2026-11-01T00:00:00+09:00"
                }
              }
            }
          ]
        }
      },
      "aggs": {
        "sources": {
          "terms": {
            "field": "decoder.name",
            "size": 15
          }
        }
      },
