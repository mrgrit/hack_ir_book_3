GET /book3-pcap-ch12/_search
{
  "size": 5,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2025-01-22T19:44:00Z",
              "lt": "2025-01-22T20:39:00Z"
            }
          }
        },
        {
          "term": {
            "data.event_type": "flow"
          }
        },
        {
          "term": {
            "data.dest_ip": "5.252.153.241"
          }
        }
      ]
    }
  },
  "aggs": {
    "to_server": {
      "sum": {
        "field": "data.flow.bytes_toserver"
      }
    },
    "to_client": {
      "sum": {
        "field": "data.flow.bytes_toclient"
      }
    }
  },
  "sort": [
    {
      "data.flow.start": "asc"
    }
  ],
  "_source": [
    "timestamp",
    "data.flow_id",
    "data.src_ip",
    "data.src_port",
    "data.dest_ip",
    "data.dest_port",
    "data.flow"
  ]
}
