GET /book3-pcap-ch12/_search
{
  "size": 1,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2025-01-22T19:44:00Z",
              "lt": "2025-01-22T20:39:00Z"
            }
          }
        },
        {
          "term": {
            "data.event_type": "alert"
          }
        }
      ]
    }
  },
  "aggs": {
    "signatures": {
      "terms": {
        "field": "data.alert.signature_id",
        "size": 20
      }
    }
  },
  "sort": [
    {
      "timestamp": "asc"
    }
  ],
  "_source": [
    "timestamp",
    "data.event_type",
    "data.http.hostname",
    "data.http.url",
    "data.alert"
  ]
}
