  "03": {
    "title": "반복 HTTP 경로의 응답과 누락",
    "method": "GET",
    "path": "/book3-pcap-ch12/_search",
    "body": {
      "size": 2,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2025-01-22T19:44:00Z",
                  "lt": "2025-01-22T20:39:00Z"
                }
              }
            },
            {
              "term": {
                "data.event_type": "http"
              }
            },
            {
              "term": {
                "data.http.url": "/1517096937"
              }
            },
            {
              "term": {
                "data.dest_ip": "5.252.153.241"
              }
            }
          ]
        }
      },
      "aggs": {
        "status": {
          "terms": {
            "field": "data.http.status",
            "size": 20
          }
        },
        "without_status": {
          "filter": {
            "bool": {
              "must_not": [
                {
                  "exists": {
                    "field": "data.http.status"
                  }
                }
              ]
            }
          }
        },
        "flows": {
          "cardinality": {
            "field": "data.flow_id"
          }
        }
      },
      "sort": [
        {
          "timestamp": "asc"
        }
      ],
      "_source": [
        "timestamp",
        "data.timestamp",
        "data.flow_id",
        "data.pcap_cnt",
        "data.tx_id",
        "data.http.status",
        "data.http.url"
      ]
    }
  },
