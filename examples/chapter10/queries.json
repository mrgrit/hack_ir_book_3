          },
          "aggs": {
            "hosts": {
              "terms": {
                "field": "agent.name",
                "size": 20
              }
            }
          }
        }
      }
    }
  },
  "02": {
    "title": "같은 폴더와 시간의 종류별 이벤트 및 고유 경로",
    "method": "GET",
    "path": "/book3-r10-ch10/_search",
    "body": {
      "size": 0,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2026-10-30T03:00:00+09:00",
                  "lt": "2026-10-30T03:20:00+09:00"
                }
              }
            },
            {
              "prefix": {
                "decoder.name": "syscheck"
              }
            },
            {
              "term": {
                "agent.name": "govportal"
              }
            },
            {
              "prefix": {
                "syscheck.path": "/srv/share/minwon/"
              }
            }
          ]
        }
      },
      "aggs": {
        "kinds": {
          "filters": {
            "filters": {
              "locked_added": {
                "bool": {
                  "filter": [
                    {
                      "wildcard": {
                        "syscheck.path": "*.kt66lock"
                      }
                    },
                    {
                      "term": {
                        "syscheck.event": "added"
                      }
                    }
                  ]
                }
              },
              "note_added": {
                "bool": {
                  "filter": [
                    {
                      "wildcard": {
                        "syscheck.path": "*README_RESTORE.txt"
                      }
                    },
                    {
                      "term": {
                        "syscheck.event": "added"
                      }
                    }
                  ]
                }
              },
              "original_deleted": {
                "bool": {
                  "filter": [
                    {
                      "wildcard": {
                        "syscheck.path": "*.hwp"
                      }
                    },
                    {
                      "term": {
                        "syscheck.event": "deleted"
                      }
                    }
                  ]
                }
              }
            }
          },
          "aggs": {
            "paths": {
              "cardinality": {
                "field": "syscheck.path"
              }
            },
            "first": {
              "min": {
                "field": "timestamp"
              }
            },
            "last": {
              "max": {
                "field": "timestamp"
              }
            }
          }
        }
      }
    }
  },
