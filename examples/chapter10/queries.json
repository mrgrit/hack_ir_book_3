  "01": {
    "title": "최근 사흘의 FIM 10분 구간과 호스트",
    "method": "GET",
    "path": "/book3-r10-ch10/_search",
    "body": {
      "size": 0,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2026-10-29T00:00:00+09:00",
                  "lt": "2026-11-01T00:00:00+09:00"
                }
              }
            },
            {
              "prefix": {
                "decoder.name": "syscheck"
              }
            }
          ]
        }
      },
      "aggs": {
        "times": {
          "date_histogram": {
            "field": "timestamp",
