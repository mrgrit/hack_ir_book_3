GET /book3-r10-ch10/_search
{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-10-29T00:00:00+09:00",
              "lt": "2026-11-01T00:00:00+09:00"
            }
          }
        },
        {
          "prefix": {
            "decoder.name": "syscheck"
          }
        }
      ]
    }
  },
  "aggs": {
    "times": {
      "date_histogram": {
        "field": "timestamp",
        "fixed_interval": "10m",
        "time_zone": "+09:00",
        "min_doc_count": 1
      },
      "aggs": {
        "hosts": {
          "terms": {
            "field": "agent.name",
            "size": 20
          }
        }
      }
    }
  }
}
