  "08": {
    "title": "업로드 PHP 경로의 호출 출발지",
    "method": "GET",
    "path": "/book3-r04-ch04/_search",
    "body": {
      "size": 0,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2026-08-03T00:00:00+09:00",
