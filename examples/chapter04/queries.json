  "06": {
    "title": "업로드 폴더에 추가된 파일의 확장자",
    "method": "GET",
    "path": "/book3-r04-ch04/_search",
    "body": {
      "size": 0,
      "track_total_hits": true,
      "query": {
        "bool": {
          "filter": [
            {
              "range": {
                "timestamp": {
                  "gte": "2026-08-03T00:00:00+09:00",
                  "lt": "2026-11-01T00:00:00+09:00"
                }
              }
            },
            {
              "term": {
                "rule.id": "554"
              }
            },
            {
              "wildcard": {
                "syscheck.path": "/var/www/*/uploads/*"
              }
            }
          ]
        }
      },
      "aggs": {
        "extensions": {
          "filters": {
            "filters": {
              "jpg": {
                "wildcard": {
                  "syscheck.path": "*.jpg"
                }
              },
              "png": {
                "wildcard": {
                  "syscheck.path": "*.png"
                }
              },
              "pdf": {
                "wildcard": {
                  "syscheck.path": "*.pdf"
                }
              },
              "php": {
                "wildcard": {
                  "syscheck.path": "*.php"
                }
              }
            }
          }
        }
      }
    }
  },
