GET /book3-r04-ch04/_search
{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "timestamp": {
              "gte": "2026-08-03T00:00:00+09:00",
              "lt": "2026-11-01T00:00:00+09:00"
            }
          }
        },
        {
          "term": {
            "data.audit.parent": "/usr/sbin/cron"
          }
        }
      ]
    }
  },
  "aggs": {
    "executables": {
      "terms": {
        "field": "data.audit.exe",
        "size": 3
      },
      "aggs": {
        "first": {
          "min": {
            "field": "timestamp"
          }
        },
        "last": {
          "max": {
            "field": "timestamp"
          }
        },
        "hosts": {
          "cardinality": {
